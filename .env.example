# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.

# --- Plaid (https://dashboard.plaid.com/developers/keys) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Public URL Plaid calls when banks have new data (deployed only). Leave empty locally.
PLAID_WEBHOOK_URL=https://your-app.vercel.app/api/plaid/webhook

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI categorization fallback (optional; at least one recommended) ---
GROQ_API_KEY=
GOOGLE_AI_API_KEY=

# --- SMS weekly digest (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MY_PHONE=

# --- Deployment security ---
# Password for the site (until Supabase Auth replaces it). Required when deployed.
APP_PASSWORD=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/sync. Generate: openssl rand -hex 32
CRON_SECRET=
