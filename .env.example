# Copy to .env.local for local dev. On Vercel: Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Accounts ---
# Encrypts each user's Plaid secret at rest. Generate once: openssl rand -base64 32
# Must be identical everywhere (local + Vercel); changing it makes stored secrets unreadable.
CREDENTIALS_ENCRYPTION_KEY=
# Your email. When you sign up / sign in with it, data from the old single-user
# version is moved to your account.
LEGACY_OWNER_EMAIL=

# --- Plaid ---
# Each user enters their own Plaid keys at sign-up (stored encrypted), so there are
# no PLAID_CLIENT_ID / PLAID_SECRET variables anymore.
# Public URL Plaid calls when banks have new data (deployed only).
PLAID_WEBHOOK_URL=https://your-app.vercel.app/api/plaid/webhook

# --- AI (assistant + categorization fallback) ---
GROQ_API_KEY=
GOOGLE_AI_API_KEY=


# --- Vercel cron (/api/cron/sync) --- generate: openssl rand -hex 32
CRON_SECRET=
